# Export desired values in the launch terminal; no automatic dotenv loading.
BUS_EDS_PORT=8000
EDS_DETECTOR_DEVICE=cpu
# Optional path overrides; relative paths are resolved against the project root.
# EDS_DETECTOR_WEIGHTS=models/yolo-v6-finetuned/best_v6.pt
# EDS_TROCR_CACHE=.cache/trocr
# EDS_EASYOCR_CACHE=.cache/easyocr
EDS_DETECTOR_IMAGE_SIZE=640
EDS_TORCH_THREADS=4
EDS_DEFAULT_BACKEND=easyocr
EDS_DEFAULT_INTERVAL_MS=500
EDS_MIN_INTERVAL_MS=100
EDS_MAX_IMAGE_BYTES=16777216
EDS_MAX_VIDEO_BYTES=268435456
EDS_MAX_VIDEO_DURATION_SECONDS=600
EDS_VIDEO_TTL_SECONDS=3600
EDS_MAX_VIDEO_UPLOADS=5
